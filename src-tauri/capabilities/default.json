{
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://chat.deepseek.com/*" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$TEMP/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$TEMP/**" }]
    },
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$TEMP/**" }]
    }
  ]
}